{
  "name": "runeicons-brands",
  "version": "0.1.0",
  "description": "1,100+ brand logos of popular developer and design tools as SVG files, with each logo's license, official site and brand guidelines link. Third-party trademarks, not covered by Apache-2.0.",
  "license": "SEE LICENSE IN NOTICE.md",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./svg/*": "./svg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "svg",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "homepage": "https://runeicons.com/brands",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runeicons/runeicons.git",
    "directory": "packages/runeicons-brands"
  },
  "bugs": "https://github.com/Runeicons/runeicons/issues",
  "keywords": [
    "brand-logos",
    "logos",
    "svg",
    "brands",
    "developer-tools",
    "runeicons"
  ],
  "scripts": {
    "generate": "bun run scripts/build.ts",
    "build": "bun run generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun run generate && bun run typecheck && bun test",
    "prepublishOnly": "bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.7.0"
  }
}
