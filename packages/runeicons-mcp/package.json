{
  "name": "runeicons-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the RuneIcons library (350+ icons, 900+ variants across 5 styles) and 1,100+ third-party brand logos to AI agents: search icons and brands, resolve metadata, and get ready-to-use SVG source.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runeicons/runeicons.git",
    "directory": "packages/runeicons-mcp"
  },
  "bugs": "https://github.com/Runeicons/runeicons/issues",
  "homepage": "https://runeicons.com",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "icons",
    "svg",
    "runeicons",
    "rune-icons"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "runeicons-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "generate": "bun scripts/generate-icons.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run generate && bun test",
    "prepublishOnly": "bun run generate && bun run typecheck && bun run test && bun run build"
  }
}
