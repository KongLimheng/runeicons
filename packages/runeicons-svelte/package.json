{
  "name": "runeicons-svelte",
  "version": "0.2.0",
  "description": "Svelte 5 components for RuneIcons: 350+ icons, 900+ variants across five styles.",
  "keywords": [
    "icons",
    "svg",
    "icon-set",
    "svelte",
    "svelte5",
    "svelte-component",
    "duotone",
    "pixelated",
    "glass",
    "runeicons"
  ],
  "homepage": "https://runeicons.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runeicons/runeicons.git",
    "directory": "packages/runeicons-svelte"
  },
  "bugs": "https://github.com/Runeicons/runeicons/issues",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun run scripts/build.ts",
    "build": "bun run generate",
    "test": "bun run generate && bun run typecheck && bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "svelte": "^5.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
