{
  "name": "runeicons-vscode",
  "displayName": "RuneIcons",
  "description": "RuneIcons autocomplete, hover preview, and insert command for 350+ icons / 900+ variants in five styles.",
  "version": "0.1.0",
  "icon": "icon.png",
  "license": "Apache-2.0",
  "publisher": "Nexvyn",
  "private": true,
  "keywords": [
    "icons",
    "svg",
    "icon-set",
    "autocomplete",
    "hover",
    "runeicons"
  ],
  "homepage": "https://runeicons.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runeicons/runeicons.git",
    "directory": "packages/runeicons-vscode"
  },
  "bugs": {
    "url": "https://github.com/Runeicons/runeicons/issues"
  },
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "runeicons.insert",
        "title": "Insert Icon",
        "category": "RuneIcons"
      }
    ]
  },
  "scripts": {
    "build": "bun run scripts/build.ts && bun build src/extension.ts --external vscode --format cjs --outfile dist/extension.js",
    "vscode:prepublish": "bun run build",
    "test": "bun run build && bun run typecheck && bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.0"
  }
}
